<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <!-- Экран выбора дашборда -->
    <ScrollView
        android:id="@+id/picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pickerList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выберите дашборд"
                android:textColor="@color/fg"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingTop="24dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/pickerHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сменить дашборд или обновить страницу: кнопка «Назад» на главной странице. Долгое нажатие на дашборд — изменить ссылку."
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Экран «Нет соединения» -->
    <LinearLayout
        android:id="@+id/offline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Нет соединения"
            android:textColor="@color/fg"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:text="Данные хранятся в Google Таблицах, для работы нужен интернет."
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Повторить" />
    </LinearLayout>
</FrameLayout>
